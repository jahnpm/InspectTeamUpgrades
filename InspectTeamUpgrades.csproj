<Project Sdk="Microsoft.NET.Sdk">

  <!-- Paths: override on the command line or in a Directory.Build.props.user if yours differ -->
  <Import Project="$(MSBuildProjectDirectory)\Directory.Build.props.user" Condition="Exists('$(MSBuildProjectDirectory)\Directory.Build.props.user')" />

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>InspectTeamUpgrades</AssemblyName>
    <RootNamespace>InspectTeamUpgrades</RootNamespace>
    <Product>InspectTeamUpgrades</Product>
    <Authors>jahnpm</Authors>
    <Version>0.1.0</Version>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RestoreAdditionalProjectSources>
      https://api.nuget.org/v3/index.json;
      https://nuget.bepinex.dev/v3/index.json;
      https://nuget.samboy.dev/v3/index.json
    </RestoreAdditionalProjectSources>

    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\REPO</GameDir>
    <ManagedDir>$(GameDir)\REPO_Data\Managed</ManagedDir>
    <!-- r2modman profile to deploy the built DLL into after each build -->
    <ProfilePluginsDir Condition="'$(ProfilePluginsDir)' == ''">$(AppData)\r2modmanPlus-local\REPO\profiles\Default\BepInEx\plugins</ProfilePluginsDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.Analyzers" Version="1.*" PrivateAssets="all" />
    <PackageReference Include="BepInEx.Core" Version="5.4.*" />
    <!-- Lets us access private/internal game members (e.g. StatsUI.Text) without reflection -->
    <PackageReference Include="BepInEx.AssemblyPublicizer.MSBuild" Version="0.4.*" PrivateAssets="all" />
  </ItemGroup>

  <!-- Game assemblies (not copied to output) -->
  <ItemGroup>
    <Reference Include="Assembly-CSharp" HintPath="$(ManagedDir)\Assembly-CSharp.dll" Private="false" Publicize="true" />
    <Reference Include="UnityEngine" HintPath="$(ManagedDir)\UnityEngine.dll" Private="false" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(ManagedDir)\UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="UnityEngine.UI" HintPath="$(ManagedDir)\UnityEngine.UI.dll" Private="false" />
    <Reference Include="Unity.TextMeshPro" HintPath="$(ManagedDir)\Unity.TextMeshPro.dll" Private="false" />
    <Reference Include="Unity.InputSystem" HintPath="$(ManagedDir)\Unity.InputSystem.dll" Private="false" />
  </ItemGroup>

  <!-- Copy the built plugin into the r2modman profile so you can launch and test immediately -->
  <Target Name="DeployToProfile" AfterTargets="Build" Condition="Exists('$(ProfilePluginsDir)')">
    <MakeDir Directories="$(ProfilePluginsDir)\$(AssemblyName)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ProfilePluginsDir)\$(AssemblyName)" />
    <Message Importance="high" Text="Deployed $(TargetFileName) to $(ProfilePluginsDir)\$(AssemblyName)" />
  </Target>

</Project>
